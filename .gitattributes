# LF (linux) takes precedence by default
* text=auto eol=lf

# Windows-only scripts: CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binaries: don't touch line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.glb binary
*.bin binary
*.blend binary
*.fbx binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.zip binary
*.wav binary
*.ogg binary
*.mp3 binary
